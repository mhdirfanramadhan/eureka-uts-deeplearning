__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store
Thumbs.db

# Laporan dan catatan kerja disimpan lokal saja, tidak ikut ke repositori.
laporan/
DEPLOY.md
